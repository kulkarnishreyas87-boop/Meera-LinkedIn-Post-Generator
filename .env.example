# Copy to .env and fill in real values. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Channel IDs start with -100. The bot must be an admin of the channel.
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides
# Must support Grounding with Google Search
GEMINI_MODEL=gemini-3.8-flash
# Notes scoring below this (0-10) are marked "not now"
TRIAGE_THRESHOLD=7
# Auto-review of drafts. "Approved" still means ready for Meera to post herself - nothing is published.
# Draft quality score (0-10) >= AUTO_APPROVE_MIN is auto-approved; < AUTO_DISCARD_BELOW is
# auto-redrafted once, then auto-discarded (the note is kept). Scores in between go to Meera.
AUTO_REVIEW=true
AUTO_APPROVE_MIN=8
AUTO_DISCARD_BELOW=7
# Drafts with unfilled [VERIFY: ...] markers wait for facts instead of auto-approving
AUTO_APPROVE_WITH_VERIFY=false
# Score each Telegram note as it arrives, and draft it straight away if it clears the threshold
INSTANT_DRAFT=true
# Fact-check each draft's claims with Google Search and list credible sources (adds ~20s per draft)
SOURCE_CHECK=true
# SQLite file
DATABASE_URL=sqlite:///skinstinct.db
# Set to false to run the dashboard/API without the Telegram bot
ENABLE_BOT=true
# Set to false to disable the Monday 09:00 IST auto-draft
ENABLE_SCHEDULER=true
